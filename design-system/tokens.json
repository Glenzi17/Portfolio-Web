{
  "name": "Guilherme Lenzi",
  "source": "src/styles/style.css :root",
  "color": {
    "bg": "#f2f4f7",
    "ink": "#0c1422",
    "plate": "#e5e9ef",
    "plate-dark": "#0f1a2b",
    "mute": "#5d6980",
    "line": "rgba(12, 20, 34, 0.12)",
    "line-strong": "rgba(12, 20, 34, 0.3)",
    "blue": "#1660ab",
    "blue-hi": "#2a78d0",
    "ice": "#a9d1ff",
    "white": "#ffffff",
    "fluid-ramp": ["#0d1520", "#134397", "#1660ab", "#1f80b1", "#57beaf", "#ccf5e0"]
  },
  "font": {
    "display": "\"Inter Tight\", \"Inter\", system-ui, sans-serif",
    "body": "\"Inter\", system-ui, -apple-system, sans-serif",
    "serif": "\"Instrument Serif\", Georgia, serif",
    "mono": "\"Geist Mono\", ui-monospace, Menlo, monospace"
  },
  "fontSize": {
    "label": "0.6875rem",
    "small": "0.8125rem",
    "body": "clamp(0.9375rem, 0.9rem + 0.15vw, 1.0625rem)",
    "lead": "clamp(1.0625rem, 0.98rem + 0.35vw, 1.3125rem)",
    "h2": "clamp(2rem, 1.35rem + 2.7vw, 4rem)",
    "h1": "clamp(2.75rem, 0.9rem + 9vw, 9.5rem)"
  },
  "space": {
    "gutter": "clamp(20px, 4.5vw, 72px)",
    "gap": "clamp(16px, 2vw, 32px)",
    "section-y": "clamp(88px, 10vw, 152px)",
    "block-y": "clamp(40px, 6vw, 96px)"
  },
  "radius": { "sm": "8px", "base": "12px", "nav": "16px", "lg": "24px", "pill": "999px" },
  "motion": {
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "ease-io": "cubic-bezier(0.76, 0, 0.24, 1)",
    "fast": "0.35s",
    "base": "0.7s"
  }
}
